{
  "name": "@notadown/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:desktop": "vue-tsc --noEmit && vite build --outDir ../desktop/renderer --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@notadown/editor": "workspace:*",
    "@notadown/exporter": "workspace:*",
    "@notadown/i18n": "workspace:*",
    "@notadown/platform": "workspace:*",
    "@notadown/shared": "workspace:*",
    "@vueuse/core": "^15.0.0",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
