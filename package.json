{
  "name": "notadown",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "An offline-first Markdown editor inspired by distraction-free writing",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @notadown/web dev",
    "dev:desktop": "concurrently -k -n web,desktop -c cyan,magenta \"pnpm --filter @notadown/web dev\" \"wait-on http://127.0.0.1:5813 && pnpm --filter @notadown/desktop dev\"",
    "build": "pnpm --filter @notadown/web build",
    "build:desktop": "pnpm --filter @notadown/web build:desktop && pnpm --filter @notadown/desktop build",
    "package:desktop": "pnpm --filter @notadown/web build:desktop && pnpm --filter @notadown/desktop package",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "changelog": "node scripts/changelog.mjs",
    "update-metadata": "node scripts/update-metadata.mjs",
    "screenshot:readme": "node examples/readme-screenshot/capture.mjs"
  },
  "devDependencies": {
    "changelogen": "^0.6.2",
    "concurrently": "^10.0.6",
    "wait-on": "^9.5.1"
  }
}
